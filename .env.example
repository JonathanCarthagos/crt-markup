# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Opcional: Para produção
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend (emails de convite para partilha de projetos)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Obrigatório para enviar a qualquer destinatário (domínio verificado no Resend):
RESEND_FROM_EMAIL=noreply@carthagos.com
RESEND_FROM_NAME=CRT Markup

# URL da aplicação (para links nos emails)
# Produção: https://markup.carthagos.com
# Na Vercel sem domínio customizado: inferido automaticamente via VERCEL_URL
NEXT_PUBLIC_APP_URL=https://markup.carthagos.com
